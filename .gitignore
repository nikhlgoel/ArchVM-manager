# ---- large VM artefacts: never commit these ----
*.qcow2
*.iso
*.img
*.fd
disks/
logs/

# ---- generated by the app ----
seed/vm.conf          # contains plaintext passwords - use vm.conf.example
config.json
settings.json
vm.json
assets/archvm.ico
assets/archvm.png
assets/icon-preview.png

# ---- build output ----
build/
dist/
*.spec
*.egg-info/

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---- editors / OS ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
