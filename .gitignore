# ---- large VM artefacts: never commit these ----
*.qcow2
*.iso
*.img
*.fd
disks/
logs/

# ---- generated by the app ----
seed/vm.conf          # contains plaintext passwords - use vm.conf.example
config.json
settings.json
vm.json
# generated by build.py - a leading pattern without a slash matches at any depth,
# which the anchored "assets/..." form did not.
**/assets/archvm.ico
**/assets/archvm.png
**/assets/icon-preview.png
iso/seed.iso

# ---- build output ----
build/
dist/
*.spec
*.egg-info/

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---- editors / OS ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# ---- release packaging ----
release/
*.zip
SHA256SUMS.txt

# ---- tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# ---- macOS ----
.DS_Store
